{
  "name": "tapuziel",
  "version": "0.45.0-alpha",
  "description": "Tapuziel — a Hebrew-first (RTL) modular CMS with a visual builder. תפוזיאל: הטפוז עם הכנפיים.",
  "main": "src/server.js",
  "bin": {
    "tapuziel": "./bin/tapuz.js",
    "tapuz": "./bin/tapuz.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteNo1s3/tapuz.git"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "admin": "node src/server.js",
    "db:init": "node scripts/init-db.js",
    "build": "node -e 'require(\"./src/export\").exportAll()'",
    "test:bentml": "node scripts/smoke-bentml.js",
    "test:pzn": "node --test test/pzn/*.test.js",
    "test:pzn-roundtrip": "node scripts/smoke-pzn-roundtrip.js",
    "test:pzn-store": "node scripts/smoke-pzn-store.js",
    "test:pzn-ops": "node scripts/smoke-pzn-ops.js",
    "test:pzn-paste": "node scripts/smoke-pzn-paste.js",
    "test:agent": "node scripts/smoke-agent-bridge.js",
    "migrate:pzn": "node scripts/migrate-pzn-store.js",
    "gen:snippet": "node scripts/gen-chat-snippet.js",
    "gen:dictionary": "node scripts/gen-syntax-dictionary.js",
    "test:smoke": "node scripts/smoke-render.js && node scripts/smoke-drafts.js && node scripts/smoke-articles.js && node scripts/smoke-bentml.js && node scripts/smoke-map.js && node scripts/smoke-analytics.js && node scripts/smoke-pzn-roundtrip.js && node scripts/smoke-pzn-store.js && node scripts/smoke-pzn-ops.js && node scripts/smoke-pzn-paste.js && node scripts/smoke-agent-bridge.js"
  },
  "keywords": [
    "cms",
    "hebrew",
    "rtl",
    "static",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.1.1",
    "body-parser": "^1.20.3",
    "express": "^4.21.2"
  }
}
