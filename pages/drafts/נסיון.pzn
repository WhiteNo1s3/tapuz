    <bent-ticker id="ticker_1784307539893_qudtr" background="#0b0f1a" color="#7dd3fc" label="רוקדים" speed="fast">
      <bent-tickeritem text="277 ניסיונות — הצלחה אחת" />
      <bent-tickeritem text="נקראה על שם דולי פרטון" />
      <bent-tickeritem text="פוחלצת מוצגת עד היום באדינבורו" />
      <bent-tickeritem text="שלוש אמהות — אף אבא" />
