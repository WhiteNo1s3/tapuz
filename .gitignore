# Dependencies
node_modules/

# Secrets / local env
.env
.env.*

# Admin auth secrets — session signing key + scrypt password hashes.
# NEVER commit this: it is generated at runtime and lives outside the
# web-served config. Supply via config/auth.json or the TAPUZ_ADMIN_SECRET env.
config/auth.json

# SQLite runtime
*.db
*.sqlite
*.db-shm
*.db-wal
db/*.db
db/*.db-shm
db/*.db-wal

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Claude Code local settings (machine-local permissions; keep launch.json)
.claude/settings.local.json

# Build / temp
content/uploads/
public/build/
admin/dist/
fix_*.js
fix_*.py
tmp*
tmp_*.js
*.log

# Optional local uploads (keep folder, ignore files)
public/assets/*
!public/assets/.gitkeep
