{
  "manifest_version": 3,
  "name": "Tapuziel Bridge V2 (alpha)",
  "version": "0.2.0",
  "description": "מגשר בין תפוזיאל ל-LM Studio שרץ על המחשב שלך. המודל נשאר מקומי — שום דבר לא נחשף לאינטרנט, ואין פה מפתחות API בכלל.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tapuziel Bridge V2"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tapuziel-bridge-v2@whiteno1se",
      "strict_min_version": "128.0"
    }
  }
}
