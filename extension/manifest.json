{
  "manifest_version": 3,
  "name": "Tapuziel — מלווה ההעתקה",
  "version": "0.4.2",
  "description": "כפתור אחד מעתיק חבילת BenTML מוכנה עם המחשבה שלכם. מדביקים בכל צ׳אט AI שיש לכם, שולחים בעצמכם, ומדביקים את התשובה חזרה — והיא הופכת לדף אמיתי. בלי נוכחות באתרי הצ׳אט, בלי מפתחות, בלי אוטומציה.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tapuziel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tapuziel-companion@whiteno1se",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
